# Local secrets - never commit
*.local
*.local.*
.env
.env.*
!.env.example
.dev.vars
*credentials*
*secrets*
admin-credentials*

# Wrangler / local state
.wrangler/
node_modules/
.serena/

# Versioned reference: playground/multilingual (see its README - REFERENCE ONLY).
# Ignore other local experiment folders under playground/, and local junk inside the reference.
/playground/*
!/playground/multilingual/
/playground/multilingual/.wrangler/
/playground/multilingual/node_modules/
/playground/multilingual/.serena/
/playground/multilingual/.cursor/
/playground/multilingual/storage/media/**

# Optional local media copy for R2 re-sync only
storage/media/**
!storage/media/
!storage/media/.gitkeep
!storage/media/images/
!storage/media/images/.gitkeep
!storage/media/videos/
!storage/media/videos/.gitkeep
!storage/README.md

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo
