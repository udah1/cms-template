# Copy to .dev.vars for local Wrangler secrets if needed.
# Do not commit real values.

# Optional overrides for local acceptance tests only (never production / never CI)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<local demo password from README>
# BASE_URL=http://127.0.0.1:8788
#
# Remote seed requires an intentional override (blocked otherwise):
# ALLOW_DEMO_REMOTE_SEED=1

# Optional R2 sync override
# R2_BUCKET=cms-template-media
